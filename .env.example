APP_ENV=development
RUN_SEED_ON_STARTUP=false
HTTP_PORT=8080

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=bebii_blog

JWT_SECRET=super-secret-key
JWT_EXPIRES_IN_HOURS=24

# Rolling retention (hours) for scraper_logs, login_logs, bulk_post_logs. ≤0 disables automatic cleanup.
ADMIN_LOG_RETENTION_HOURS=24

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=180
REDIS_CACHE_NAMESPACE=bebii-blog
REDIS_CACHE_ADMIN_AUTHORIZED=false

SITE_SETTING_CACHE_TTL_SECONDS=300
NAV_CATEGORIES_CACHE_TTL_SECONDS=3600
POST_VIEW_RANK_CACHE_TTL_SECONDS=60
IMAGE_RESIZE_CACHE_TTL_SECONDS=604800

# PUBLIC_SITE_URL=http://localhost:3000
# SEO_BASE_URL=http://localhost:3000
# PUBLIC_ARTICLE_PATH_PREFIX=blog

# Portfolio sales site. Apex host serves the landing page and articles.
# Buyer sites are {name}.PORTFOLIO_ROOT_DOMAIN. Point wildcard DNS at this app.
PORTFOLIO_ROOT_DOMAIN=localhost
PORTFOLIO_PRICE=149000
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Notification URL in the Midtrans dashboard:
# https://your-domain/api/v1/portfolio/midtrans/notification
