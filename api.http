{
  "name": "New Category",
  "slug": "new-category"
}

###
### Get category by id
GET {{baseUrl}}{{apiPrefix}}/admin/categories/1
Authorization: Bearer {{token}}
Accept: application/json

###
### Update category
PUT {{baseUrl}}{{apiPrefix}}/admin/categories/1
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "Updated Category",
  "slug": "category-1-updated"
}

###
### Delete category
DELETE {{baseUrl}}{{apiPrefix}}/admin/categories/1
Authorization: Bearer {{token}}
Accept: application/json


###
### TAGS CRUD
###

### List tags
GET {{baseUrl}}{{apiPrefix}}/admin/tags?page=1&size=10&q=ai
Authorization: Bearer {{token}}
Accept: application/json

###
### Create tag
POST {{baseUrl}}{{apiPrefix}}/admin/tags
Authorization: Bearer {{token}}
Content-Type: application/json
