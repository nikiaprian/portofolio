@baseUrl = http://localhost:8080
@apiPrefix = /api/v1
@token = 

### Health
GET {{baseUrl}}/health


###
### PUBLIC (no JWT)
###

### List published posts (e.g. after scraper runs)
GET {{baseUrl}}{{apiPrefix}}/posts?page=1&size=10
Accept: application/json

###
### Get published post by slug
GET {{baseUrl}}{{apiPrefix}}/posts/slug/your-post-slug
Accept: application/json

###
### List categories (public)
GET {{baseUrl}}{{apiPrefix}}/categories?page=1&size=50
Accept: application/json


###
### AUTH
###

### Register
POST {{baseUrl}}{{apiPrefix}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "New User",
  "email": "newuser@example.com",
  "password": "secret123"
}

###
### Login
POST {{baseUrl}}{{apiPrefix}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin@bebii.com",
  "password": "admin123"
}

###
### Logout
POST {{baseUrl}}{{apiPrefix}}/auth/logout
Authorization: Bearer {{token}}
Accept: application/json

###
### USERS CRUD
###

### List users
GET {{baseUrl}}{{apiPrefix}}/admin/users?page=1&size=10&q=admin
Authorization: Bearer {{token}}
Accept: application/json

###
### Create user
POST {{baseUrl}}{{apiPrefix}}/admin/users
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "New User 2",
  "email": "newuser2@example.com",
  "password": "secret123"
}

###
### Get user by id
GET {{baseUrl}}{{apiPrefix}}/admin/users/1
Authorization: Bearer {{token}}
Accept: application/json

###
### Update user
PUT {{baseUrl}}{{apiPrefix}}/admin/users/1
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "New User 2 Updated",
  "email": "newuser2@example.com",
  "password": "newsecret"
}

###
### Delete user
DELETE {{baseUrl}}{{apiPrefix}}/admin/users/1
Authorization: Bearer {{token}}
Accept: application/json


###
### CATEGORIES CRUD
###

### List categories
GET {{baseUrl}}{{apiPrefix}}/admin/categories?page=1&size=10&q=teknologi
Authorization: Bearer {{token}}
Accept: application/json

###
### Create category
POST {{baseUrl}}{{apiPrefix}}/admin/categories
Authorization: Bearer {{token}}
